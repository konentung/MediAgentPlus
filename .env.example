# ---- Flask ----
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me
LOG_LEVEL=INFO

# ---- PostgreSQL ----
DATABASE_URL=postgresql+psycopg://mediagent:mediagent@localhost:5432/mediagent

# ---- LINE Messaging API (官方帳號 / Bot) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- LINE Login (OAuth 2.0 / OpenID Connect) ----
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://localhost:5000/api/v1/auth/line/callback
LINE_LOGIN_SCOPE=profile openid

# ---- LIFF (掛在 LINE Login channel 底下) ----
LIFF_ID=
# LIFF 的 id_token aud 即 LINE Login channel id；留空則沿用 LINE_LOGIN_CHANNEL_ID
LIFF_CHANNEL_ID=

# ---- JWT (自家 API 的存取憑證) ----
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_DAYS=30
