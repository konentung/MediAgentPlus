# ---- Flask ----
FLASK_APP=wsgi.py
# 未設定時視為 production（缺必要變數或使用範例金鑰會啟動失敗）；本機開發請設 development
FLASK_ENV=development
# 產生：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
LOG_LEVEL=INFO
# 部署在 ngrok / nginx 等 reverse proxy 後面時設為信任的層數（通常 1），才會採用 X-Forwarded-For
TRUSTED_PROXY_COUNT=0

# ---- PostgreSQL ----
DATABASE_URL=postgresql+psycopg://mediagent:mediagent@localhost:5432/mediagent

# ---- LINE Messaging API (官方帳號 / Bot) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- LINE Login (OAuth 2.0 / OpenID Connect) ----
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://localhost:5000/api/v1/auth/line/callback
LINE_LOGIN_SCOPE=profile openid

# ---- LIFF (掛在 LINE Login channel 底下) ----
LIFF_ID=
# LIFF 的 id_token aud 即 LINE Login channel id；留空則沿用 LINE_LOGIN_CHANNEL_ID
LIFF_CHANNEL_ID=

# ---- JWT (自家 API 的存取憑證) ----
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_DAYS=30

# ---- Redis（選用）----
# 設定後 OAuth state 與 rate limit 改用 Redis，多 worker / 多機部署必填；留空用單程序記憶體
REDIS_URL=

# ---- 病人資料欄位加密 (身分證字號) ----
# 產生：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空時由 SECRET_KEY 衍生（僅開發用）；正式環境必填
PATIENT_DATA_KEY=
