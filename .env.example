# ---- Flask ----
FLASK_APP=wsgi.py
# 未設定時視為 production（缺必要變數或使用範例金鑰會啟動失敗）；本機開發請設 development
FLASK_ENV=development
# 產生：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
LOG_LEVEL=INFO
# 部署在 ngrok / nginx 等 reverse proxy 後面時設為信任的層數（通常 1），才會採用 X-Forwarded-For
TRUSTED_PROXY_COUNT=0

# ---- PostgreSQL ----
DATABASE_URL=postgresql+psycopg://mediagent:mediagent@localhost:5432/mediagent

# ---- LINE Messaging API (官方帳號 / Bot) ----
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- LINE Login (OAuth 2.0 / OpenID Connect) ----
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://localhost:5000/api/v1/auth/line/callback
LINE_LOGIN_SCOPE=profile openid

# ---- LIFF (掛在 LINE Login channel 底下) ----
LIFF_ID=
# LIFF 的 id_token aud 即 LINE Login channel id；留空則沿用 LINE_LOGIN_CHANNEL_ID
LIFF_CHANNEL_ID=

# ---- JWT (自家 API 的存取憑證) ----
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_STAFF_ACCESS_EXPIRES_SECONDS=28800   # 院方後台帳號的登入效期（秒），到期重新登入

# ---- Redis（選用）----
# 設定後 OAuth state 與 rate limit 改用 Redis，多 worker / 多機部署必填；留空用單程序記憶體
REDIS_URL=

# ---- 病人資料欄位加密 (身分證字號) ----
# 產生：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空時由 SECRET_KEY 衍生（僅開發用）；正式環境必填
PATIENT_DATA_KEY=

# ---- OpenAI（對話助理與處方辨識）----
OPENAI_API_KEY=
# 留空用預設：對話 gpt-4.1-mini、處方辨識 gpt-4.1
AI_MODEL=
OCR_MODEL=
# 知識庫語意檢索的向量模型（留空只用關鍵字檢索）
EMBEDDING_MODEL=text-embedding-3-small
AI_TIMEOUT_SECONDS=60
OCR_TIMEOUT_SECONDS=90
# 處方箋照片（加密）存放目錄
MEDIA_ROOT=var/media

# ---- AI 對話助理（RAG + 事件判斷後套用 LINE 模組）----
# 關掉時自由文字退回關鍵字比對
AI_ENABLED=true
AI_HISTORY_TURNS=6
KNOWLEDGE_TOP_K=4
# 衛教 PDF 一次上傳的總大小上限（MB）；大檔請走本機網址，經 ngrok 會很慢
KNOWLEDGE_UPLOAD_MAX_MB=1024

# ---- 程序內排程（APScheduler）：服藥提醒每 5 分鐘、急診資料每 15 分鐘；不需要 cron ----
# 多 worker 部署請設 REDIS_URL 讓排程用鎖去重；關閉排程設 false
SCHEDULER_ENABLED=true
# LINE webhook 收到事件立刻回 200、背景處理（AI / 辨識太慢時 LINE 才不會重送同一事件造成重複訊息）
WEBHOOK_ASYNC=true

# ---- 系統管理員 ----
# 這些 LINE userId（U 開頭，逗號分隔）登入或加好友時自動成為 SUPER_ADMIN；其他角色在後台「人員與角色」指派
SUPER_ADMIN_LINE_USER_IDS=

# ---- 服藥提醒 ----
REMINDER_WINDOW_MINUTES=15
REFILL_REMINDER_DAYS_BEFORE=3

# ---- 急診動態分流（找醫院） ----
# 健保署急診即時訊息 API（公開、不需金鑰）
NHI_ER_API_URL=https://info.nhi.gov.tw/api/inae4000/inae4001s01/SQL0002
NHI_ER_TIMEOUT_SECONDS=20
# 最新快照超過幾分鐘視為過舊（LINE / LIFF 查詢時會即時補抓一次）
TRIAGE_STALE_MINUTES=30
# 快照保留天數（poll 時自動清除更舊的）
TRIAGE_RETENTION_DAYS=30
